+static int bq25700_sync_pd(struct bq25700_device *charger)
+{
+	struct power_supply *notify_psy = NULL;
+	union power_supply_propval online;
+	union power_supply_propval current_limit;
+	union power_supply_propval voltage;
+	struct bq25700_state state;
+	int cur_idx, vol_idx;
+	int ret;
+
+	mutex_lock(&charger->sync_lock);
+	if (charger->shutting_down) {
+		ret = -ESHUTDOWN;
+		goto out_unlock;
+	}
+
+	if (charger->notify_node) {
+		notify_psy = power_supply_get_by_phandle(charger->dev->of_node,
+							  "ti,usb-charger-detection");
+	}
+	if (IS_ERR_OR_NULL(notify_psy) && charger->plat_data.notify_device) {
+		notify_psy = power_supply_get_by_name(
+						charger->plat_data.notify_device);
+	}
+
+	if (IS_ERR_OR_NULL(notify_psy)) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+
+	ret = power_supply_get_property(notify_psy, POWER_SUPPLY_PROP_ONLINE,
+					       &online);
+	if (ret)
+		goto out_put;
+	if (!online.intval) {
+		ret = -ENOTCONN;
+		goto out_put;
+	}
+
+	ret = power_supply_get_property(notify_psy,
+					       POWER_SUPPLY_PROP_CURRENT_MAX,
+					       &current_limit);
+	if (ret)
+		goto out_put;
+
+	ret = power_supply_get_property(notify_psy,
+					       POWER_SUPPLY_PROP_VOLTAGE_NOW,
+					       &voltage);
+	if (ret)
+		goto out_put;
+
+	if (current_limit.intval <= 0 || voltage.intval <= 0) {
+		ret = -EAGAIN;
+		goto out_put;
+	}
+
+	cur_idx = bq25700_find_idx(current_limit.intval, TBL_INPUTCUR);
+	vol_idx = bq25700_input_voltage_idx(voltage.intval);
+	ret = bq25700_field_write(charger, INPUT_CURRENT, cur_idx);
+	if (ret)
+		goto out_put;
+	ret = bq25700_field_write(charger, INPUT_VOLTAGE, vol_idx);
+	if (ret)
+		goto out_put;
+	ret = bq25700_field_write(charger, CHARGE_CURRENT,
+					 charger->init_data.ichg);
+	if (ret)
+		goto out_put;
+
+	ret = bq25700_get_chip_state(charger, &state);
+	if (ret)
+		goto out_put;
+	charger->state = state;
+	WRITE_ONCE(charger->startup_sync_done, true);
+	power_supply_changed(charger->supply_charger);
+	dev_info(charger->dev,
+		 "startup PD sync: INPUT_CURRENT:%d, INPUT_VOLTAGE:%d, CHARGE_CURRENT:%d\n",
+		 cur_idx, vol_idx, charger->init_data.ichg);
+
+out_put:
+	power_supply_put(notify_psy);
+	out_unlock:
+	mutex_unlock(&charger->sync_lock);
+	return ret;
+}
+
+static void bq25700_startup_sync_worker(struct work_struct *work)
+{
+	struct bq25700_device *charger = container_of(work,
+							      struct bq25700_device,
+							      startup_sync_work.work);
+	int ret;
+
+	if (READ_ONCE(charger->shutting_down) || charger->automode != 1)
+		return;
+
+	ret = bq25700_sync_pd(charger);
+	if (!ret)
+		return;
+
+	if (READ_ONCE(charger->shutting_down) ||
+	    READ_ONCE(charger->startup_sync_done))
+		return;
+
+	charger->startup_sync_attempts++;
+	if (charger->startup_sync_attempts < BQ25700_STARTUP_SYNC_MAX_ATTEMPTS &&
+	    !READ_ONCE(charger->shutting_down)) {
+		queue_delayed_work(charger->usb_charger_wq,
+				   &charger->startup_sync_work,
+					   msecs_to_jiffies(BQ25700_STARTUP_SYNC_DELAY_MS));
+		return;
+	}
+
+	if (ret != -ENOTCONN && ret != -ENODEV)
+		dev_warn(charger->dev,
+			 "startup PD sync did not observe a valid input after %u attempts: %d\n",
+			 charger->startup_sync_attempts, ret);
+
+	if (charger->works_initialized && charger->usb_charger_wq &&
+	    bq25700_field_read(charger, AC_STAT))
+		queue_delayed_work(charger->usb_charger_wq,
+				   &charger->resume_charge_work, 0);
+}
