 }
 
+static void bq25700_resume_charge_worker(struct work_struct *work)
+{
+	struct bq25700_device *charger = container_of(work,
+						      struct bq25700_device,
+						      resume_charge_work.work);
+	struct bq25700_state state;
+	int ret;
+
+	if (READ_ONCE(charger->shutting_down))
+		return;
+
+	/* If a PD source can supply power parameters, let it take precedence */
+	ret = bq25700_sync_pd(charger);
+	if (ret == 0) {
+		dev_info(charger->dev, "charge resumed via PD sync\n");
+		return;
+	}
+
+	mutex_lock(&charger->sync_lock);
+	if (charger->shutting_down) {
+		mutex_unlock(&charger->sync_lock);
+		return;
+	}
+
+	if (!bq25700_field_read(charger, AC_STAT)) {
+		mutex_unlock(&charger->sync_lock);
+		return;
+	}
+
+	ret = bq25700_get_chip_state(charger, &state);
+	if (ret) {
+		mutex_unlock(&charger->sync_lock);
+		return;
+	}
+
+	if (state.fault_acov || state.fault_batoc || state.fault_acoc ||
+	    state.fault_latchoff || state.in_otg) {
+		dev_warn(charger->dev,
+			 "charge resume inhibited: fault/otg active\n");
+		mutex_unlock(&charger->sync_lock);
+		return;
+	}
+
+	bq25700_enable_typec0(charger);
+	bq25700_field_write(charger, INPUT_CURRENT,
+			    charger->init_data.input_current_sdp);
+	bq25700_field_write(charger, CHARGE_CURRENT,
+			    charger->init_data.ichg);
+
+	bq25700_get_chip_state(charger, &state);
+	charger->state = state;
+	power_supply_changed(charger->supply_charger);
+
+	dev_info(charger->dev,
+		 "charge auto-resumed on AC_STAT: INPUT_CURRENT=%d, CHARGE_CURRENT=%d\n",
+		 charger->init_data.input_current_sdp, charger->init_data.ichg);
+
+	mutex_unlock(&charger->sync_lock);
+}
