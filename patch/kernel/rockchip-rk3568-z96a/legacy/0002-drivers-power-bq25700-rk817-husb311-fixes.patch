+	    battery->voltage_avg + 50 < battery->pdata->design_max_voltage)
+		return;
+
+	soc_gap = battery->rsoc - battery->dsoc;
+	if (soc_gap < 20 * 1000)
+		return;
+
+	BAT_INFO("full-charge DSOC recovery: dsoc=%d rsoc=%d\n",
+		 battery->dsoc, battery->rsoc);
+	battery->dsoc = min(battery->rsoc, 100 * 1000);
+	battery->smooth_soc = battery->dsoc;
+	battery->sm_remain_cap = battery->remain_cap;
+	battery->work_mode = MODE_FINISH;
+	battery->finish_base = get_boot_sec();
