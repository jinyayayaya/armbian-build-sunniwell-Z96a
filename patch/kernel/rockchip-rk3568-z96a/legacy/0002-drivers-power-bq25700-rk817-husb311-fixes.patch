@@ -1312,21 +1492,90 @@ static int bq2570x_pd_notifier_call(struct notifier_block *nb,
 
 		bq25700_get_chip_state(bq, &state);
 		bq->state = state;
+		WRITE_ONCE(bq->startup_sync_done, true);
 		power_supply_changed(bq->supply_charger);
